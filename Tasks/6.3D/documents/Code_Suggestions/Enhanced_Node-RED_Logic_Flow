function calculateLightingNeeds(msg) {
  const ambient = msg.payload.ambientLight;
  const hour = new Date().getHours();
  const location = msg.payload.location;
  
  // Determine time slot
  let timeSlot;
  if (hour >= 6 && hour < 12) timeSlot = "morning";
  else if (hour >= 12 && hour < 18) timeSlot = "afternoon"; 
  else if (hour >= 18 && hour < 22) timeSlot = "evening";
  else timeSlot = "night";
  
  // Get appropriate rule for time and location
  const rule = getRuleForTimeAndLocation(timeSlot, location);
  
  // Calculate required brightness
  let targetBrightness = 0;
  if (ambient < rule.threshold) {
    targetBrightness = rule.brightness;
  }
  
  return {
    bulbId: getBulbForLocation(location),
    brightness: targetBrightness,
    colorTemperature: rule.colorTemperature,
    timeSlot: timeSlot
  };
}

