// Lambda Functions for Monitoring
// HealthMonitoringLambda
exports.handler = async (event) => {
  const healthData = JSON.parse(event.Records[0].body);
  
  // Check if device is healthy
  if (healthData.status === 'offline' || healthData.batteryLevel < 20) {
    await sendAlert(healthData);
  }
  
  // Store metrics in CloudWatch
  await putMetricData(healthData);
  
  // Update device status in DynamoDB
  await updateDeviceStatus(healthData);
};

