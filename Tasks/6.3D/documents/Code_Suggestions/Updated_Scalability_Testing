// Load testing with realistic light patterns
const simulateRoom = (roomId, sensorCount) => {
  for (let i = 0; i < sensorCount; i++) {
    const sensorId = `sensor_${roomId}_${String(i).padStart(2, '0')}`;
    const location = `room_${roomId}`;
    
    setInterval(() => {
      const sensorData = {
        sensorId: sensorId,
        location: location,
        ambientLight: simulateAmbientLight(),
        timestamp: Date.now(),
        batteryLevel: 85 + Math.random() * 15 // 85-100%
      };
      
      publishToMQTT(`iot/sensors/${location}/ambient_light/${sensorId}/data`, sensorData);
    }, 5000); // Every 5 seconds
  }
};

// Test scenario: 10 rooms, 5 sensors per room = 50 devices
for (let room = 1; room <= 10; room++) {
  simulateRoom(room, 5);
}