// Device State Updates
Pattern: iot/status/{location}/{deviceType}/{deviceId}/state

Examples:
iot/status/living_room/smart_bulb/bulb_001/state
iot/status/living_room/sensor/sensor_001/state

Smart Bulb Status Payload:
{
  "deviceId": "bulb_001",
  "deviceType": "smart_bulb",
  "location": "living_room",
  "currentState": {
    "power": "ON",
    "brightness": 75,              // 0-100%
    "colorTemperature": 3000,      // Kelvin
    "color": null,                 // RGB if color bulb
    "dimming": false,              // Currently dimming?
    "energyUsage": 9.2             // Current watts
  },
  "requestedState": {              // What was requested vs actual
    "power": "ON",
    "brightness": 75,
    "colorTemperature": 3000
  },
  "stateChangeReason": "automation", // automation/manual/schedule/remote
  "lastChanged": 1678886400000,
  "timestamp": 1678886400000
}

Sensor Status Payload:
{
  "deviceId": "sensor_001", 
  "deviceType": "ambient_light_sensor",
  "location": "living_room",
  "currentState": {
    "status": "active",            // active/sleeping/calibrating
    "samplingRate": 5000,          // ms between readings
    "calibrationOffset": 0,        // Calibration adjustment
    "autoMode": true
  },
  "lastReading": {
    "ambientLight": 445,
    "readingQuality": "high",      // high/medium/low
    "timestamp": 1678886395000
  },
  "timestamp": 1678886400000
}

// Command Acknowledgments Topic
Pattern: iot/status/{location}/{deviceType}/{deviceId}/ack

Examples:
iot/status/living_room/smart_bulb/bulb_001/ack

Payload:
{
  "deviceId": "bulb_001",
  "commandId": "cmd_12345",       // Reference to original command
  "originalCommand": {
    "action": "set_brightness",
    "brightness": 75,
    "colorTemperature": 3000
  },
  "acknowledgment": {
    "status": "completed",         // received/processing/completed/failed
    "executionTime": 1250,        // ms to complete
    "actualResult": {
      "brightness": 74,           // Actual vs requested (bulb limitations)
      "colorTemperature": 3000
    },
    "errorMessage": null
  },
  "timestamp": 1678886400000
}

// State Synchronization Topic
Pattern: iot/status/{location}/sync/{deviceId}

Examples:
iot/status/living_room/sync/bulb_001

Payload:
{
  "deviceId": "bulb_001",
  "syncType": "state_request",    // state_request/state_response/conflict_resolution
  "cloudState": {                 // What cloud thinks device state is
    "brightness": 75,
    "power": "ON",
    "lastUpdated": 1678886300000
  },
  "deviceState": {               // What device reports its state is
    "brightness": 73,             // Slight difference due to hardware
    "power": "ON", 
    "lastUpdated": 1678886398000
  },
  "syncResolution": "use_device_state", // How to resolve differences
  "timestamp": 1678886400000
}