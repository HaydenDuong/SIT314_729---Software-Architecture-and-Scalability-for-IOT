// Device Health Monitoring Topic
Pattern: iot/system/health/{location}/{deviceType}/{deviceId}

Examples:
iot/system/health/living_room/sensor/sensor_001
iot/system/health/living_room/smart_bulb/bulb_001

Payload:
{
  "deviceId": "sensor_001",
  "deviceType": "ambient_light_sensor",
  "location": "living_room",
  "status": "online",              // online/offline/degraded
  "lastSeen": 1678886400000,
  "batteryLevel": 87,              // For battery devices
  "signalStrength": -45,           // WiFi signal (dBm)
  "firmwareVersion": "1.2.3",
  "uptimeSeconds": 86400,          // Device uptime
  "memoryUsage": 65,               // % memory used
  "cpuUsage": 12,                  // % CPU usage
  "errorCount": 0,                 // Errors in last hour
  "timestamp": 1678886400000
}

// Error Reporting Topic
Pattern: iot/system/errors/{location}/{deviceType}/{deviceId}

Examples:
iot/system/errors/living_room/sensor/sensor_001
iot/system/errors/kitchen/smart_bulb/bulb_002

Payload:
{
  "deviceId": "sensor_001",
  "errorType": "connection_timeout",  // connection_timeout/sensor_failure/battery_low
  "severity": "warning",              // info/warning/error/critical
  "errorCode": "E001",
  "errorMessage": "Failed to connect to WiFi after 3 attempts",
  "location": "living_room",
  "timestamp": 1678886400000,
  "metadata": {
    "retryCount": 3,
    "lastSuccessfulConnection": 1678885000000,
    "wifiSSID": "HomeWiFi"
  }
}

// Performance Metrics Topic
Pattern: iot/system/metrics/{location}/{aggregation_level}

Examples:
iot/system/metrics/living_room/device_level
iot/system/metrics/house/room_level
iot/system/metrics/house/system_level

Payload (Room-level metrics):
{
  "location": "living_room",
  "aggregationLevel": "room_level",
  "metricsWindow": "last_hour",
  "deviceCount": {
    "total": 6,
    "online": 5,
    "offline": 1
  },
  "messageStats": {
    "totalMessages": 720,           // Messages in last hour
    "averageLatency": 45,           // ms
    "failedMessages": 2,
    "duplicateMessages": 0
  },
  "sensorReadings": {
    "averageAmbientLight": 425,
    "lightVariance": 85,            // How much light varies
    "lastReading": 1678886400000
  },
  "actuatorActivity": {
    "brightnessChanges": 12,        // Number of adjustments
    "totalEnergyUsed": 156.7,       // Wh in last hour
    "averageBrightness": 68
  },
  "timestamp": 1678886400000
}

// System-wide Diagnostics Topic
Pattern: iot/system/diagnostics/{scope}

Examples:
iot/system/diagnostics/network
iot/system/diagnostics/cloud_connectivity
iot/system/diagnostics/automation_engine

Payload (Network diagnostics):
{
  "diagnosticType": "network",
  "scope": "house_wide",
  "status": "healthy",             // healthy/degraded/critical
  "networkStats": {
    "totalDevices": 25,
    "connectedDevices": 23,
    "averageSignalStrength": -52,
    "networkLatency": 35,          // ms to internet
    "bandwidthUsage": 12.5,        // Mbps
    "packetLoss": 0.1              // %
  },
  "cloudConnectivity": {
    "awsIotStatus": "connected",
    "lastCloudSync": 1678886400000,
    "messageBacklog": 0,
    "apiResponseTime": 125         // ms
  },
  "timestamp": 1678886400000
}