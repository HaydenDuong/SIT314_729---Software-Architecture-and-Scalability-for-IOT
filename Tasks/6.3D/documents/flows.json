    {
        "id": "d4bc8b35c722e811",
        "type": "function",
        "z": "1f58548fe1a22c86",
        "name": "Smart Light Control Decision Engine",
        "func": "// Smart Light Control Decision Engine with State Change Detection\nconst sensorData = msg.payload;\nnode.log(`RECEIVED SENSOR DATA: ${JSON.stringify(sensorData)}`);\n\ntry {\n    // Extract sensor values\n    const lightLevel = sensorData.light_intensity || 0;\n    const motion = sensorData.motion_detected || false; // Use actual sensor motion data\n\n    // Use the lightId from sensor data\n    const lightId = sensorData.lightId;\n    \n    const timestamp = sensorData.timestamp || Date.now();\n\n    // Initialize global state storage if it doesn't exist\n    if (!global.lightStates) {\n        global.lightStates = new Map();\n    }\n\n    // Time-based brightness calculation\n    const hour = new Date().getHours();\n    let baseBrightness = 80; // Default\n\n    if (hour >= 6 && hour < 12) {\n        baseBrightness = 60;  // Morning - softer\n    } else if (hour >= 12 && hour < 18) {\n        baseBrightness = 70;  // Afternoon - moderate\n    } else if (hour >= 18 && hour < 22) {\n        baseBrightness = 90;  // Evening - bright\n    } else {\n        baseBrightness = 50;  // Night - dim\n    }\n\n    // Decision Logic\n    let shouldTurnOn = false;\n    let reason = \"\";\n\n    // Rule 1: If motion detected AND light level is low, turn on\n    if (motion && lightLevel < 200) {\n        shouldTurnOn = true;\n        reason = `Motion detected in low light (${lightLevel} lux)`;\n    }\n    // Rule 2: If no motion, turn off\n    else if (!motion) {\n        shouldTurnOn = false;\n        reason = \"No motion detected\";\n    }\n    // Rule 3: If light level is high enough, turn off\n    else if (lightLevel >= 200) {\n        shouldTurnOn = false;\n        reason = \"Sufficient natural light\";\n    }\n\n    // Create new state\n    const newState = {\n        power: shouldTurnOn ? \"ON\" : \"OFF\",\n        brightness: shouldTurnOn ? baseBrightness : 0,\n        reason: reason\n    };\n\n    // Get previous state for this light\n    const previousState = global.lightStates.get(lightId);\n\n    // STATE CHANGE DETECTION: Only proceed if state has changed\n    const stateChanged = !previousState ||\n        previousState.power !== newState.power ||\n        previousState.brightness !== newState.brightness;\n\n    if (stateChanged) {\n        // Update stored state\n        global.lightStates.set(lightId, newState);\n\n        // Create command message (only for state changes)\n        const command = {\n            lightId: lightId,\n            action: shouldTurnOn ? \"turn_on\" : \"turn_off\",\n            brightness: shouldTurnOn ? baseBrightness : 0,\n            colorTemperature: 3000,\n            reason: reason,\n            timestamp: timestamp,\n            sensorData: sensorData,\n            timeOfDay: hour >= 6 && hour < 18 ? \"day\" : \"night\",\n            baseBrightness: baseBrightness,\n            stateChanged: true,\n            previousState: previousState\n        };\n\n        // Set the output\n        msg.payload = command;\n        msg.topic = \"light_control\";\n\n        // Log the state change for monitoring\n        node.log(`STATE CHANGE: ${lightId} ${previousState ? previousState.power : 'UNKNOWN'} → ${newState.power} (${reason})`);\n\n        return msg;\n    } else {\n        // No state change - don't send command or store data\n        node.log(`NO CHANGE: ${lightId} remains ${newState.power} (${reason})`);\n        return null; // Don't trigger downstream nodes\n    }\n\n} catch (error) {\n    // This will trigger the Catch node\n    node.error(\"Error in Smart Light Control Engine: \" + error.message, msg);\n    return null;\n}",
